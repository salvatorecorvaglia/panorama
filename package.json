{
  "name": "panorama-vscode",
  "displayName": "Panorama - Universal Visual Package Manager",
  "description": "Universal Visual Package Manager for Visual Studio Code",
  "icon": "resources/panorama.png",
  "version": "2.4.0",
  "packageManager": "pnpm@11.17.0",
  "publisher": "panorama",
  "license": "MIT",
  "author": "Salvatore Corvaglia",
  "repository": {
    "type": "git",
    "url": "https://github.com/salvatorecorvaglia/panorama"
  },
  "engines": {
    "node": ">=22.13.0",
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "dependencies",
    "package manager",
    "npm",
    "pip",
    "cargo"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/requirements.txt",
    "workspaceContains:**/Cargo.toml",
    "workspaceContains:**/go.mod",
    "workspaceContains:**/composer.json",
    "workspaceContains:**/pom.xml",
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/build.gradle.kts"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "restrictedConfigurations": [
        "panorama.registryOverrides"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "panorama.open",
        "title": "Open Dependency Panel",
        "category": "Panorama",
        "icon": "$(package)"
      },
      {
        "command": "panorama.refresh",
        "title": "Refresh Dependencies",
        "category": "Panorama",
        "icon": "$(refresh)"
      },
      {
        "command": "panorama.checkUpdates",
        "title": "Check for Updates",
        "category": "Panorama",
        "icon": "$(cloud-download)"
      },
      {
        "command": "panorama.updateAll",
        "title": "Update All Dependencies",
        "category": "Panorama",
        "icon": "$(arrow-up)"
      },
      {
        "command": "panorama.searchInstall",
        "title": "Search & Install Package",
        "category": "Panorama",
        "icon": "$(search)"
      },
      {
        "command": "panorama.showWhy",
        "title": "Why Is This Installed?",
        "category": "Panorama",
        "icon": "$(type-hierarchy)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "panorama",
          "title": "Panorama",
          "icon": "resources/panorama.svg"
        }
      ]
    },
    "views": {
      "panorama": [
        {
          "type": "webview",
          "id": "panorama.sidebar",
          "name": "Panorama",
          "contextualTitle": "Panorama",
          "icon": "resources/panorama.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "panorama.open",
          "when": "view == panorama.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "panorama.searchInstall",
          "when": "view == panorama.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "panorama.checkUpdates",
          "when": "view == panorama.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "panorama.refresh",
          "when": "view == panorama.sidebar",
          "group": "navigation@4"
        },
        {
          "command": "panorama.updateAll",
          "when": "view == panorama.sidebar",
          "group": "1_modify@1"
        }
      ]
    },
    "configuration": {
      "title": "Panorama",
      "properties": {
        "panorama.autoCheckUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check registries for newer versions when the panel opens and when manifests change."
        },
        "panorama.checkIntervalMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "How often to re-check registries in the background. Set to 0 to disable periodic checks."
        },
        "panorama.enableAudit": {
          "type": "boolean",
          "default": true,
          "description": "Query OSV.dev for known vulnerabilities affecting your dependencies."
        },
        "panorama.preferredNodeManager": {
          "type": "string",
          "enum": [
            "auto",
            "npm",
            "yarn",
            "pnpm",
            "bun"
          ],
          "default": "auto",
          "description": "Which Node package manager to use. 'auto' detects it from lockfiles and the packageManager field."
        },
        "panorama.pythonManager": {
          "type": "string",
          "enum": [
            "auto",
            "pip",
            "uv",
            "poetry"
          ],
          "default": "auto",
          "description": "Which Python package manager to use. 'auto' detects it from lockfiles and pyproject.toml."
        },
        "panorama.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.venv/**",
            "**/venv/**",
            "**/target/**",
            "**/vendor/**",
            "**/dist/**",
            "**/build/**",
            "**/.git/**",
            "**/test/**",
            "**/tests/**",
            "**/fixtures/**",
            "**/__tests__/**"
          ],
          "description": "Glob patterns to skip when scanning for manifest files."
        },
        "panorama.registryOverrides": {
          "type": "object",
          "default": {},
          "description": "Override registry base URLs per ecosystem, e.g. { \"npm\": \"https://registry.mycompany.com\" }. Ignored in untrusted workspaces.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "panorama.contactEmail": {
          "type": "string",
          "default": "",
          "description": "Optional contact email included in the User-Agent sent to registries. Packagist requests one so they can reach you about unusual traffic."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "pnpm run build:host && pnpm run build:webview",
    "build:host": "node esbuild.config.mjs --production",
    "build:webview": "vite build",
    "watch": "concurrently \"node esbuild.config.mjs --watch\" \"vite build --watch\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/webview/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "pnpm run build && tsc -p tsconfig.integration.json",
    "test:integration": "vscode-test",
    "test:all": "pnpm run test && pnpm run test:integration",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@tanstack/react-virtual": "^3.14.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@types/vscode": "~1.134.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
